{
  "name": "@orca/pod",
  "version": "0.0.0",
  "private": true,
  "description": "Orca pod host bundle for DeepSeek Harness: runs an Orca node and exposes pod_* tools.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@orca/config": "*",
    "@orca/crypto": "*",
    "@orca/orca-node": "*",
    "@orca/protocol": "*"
  }
}

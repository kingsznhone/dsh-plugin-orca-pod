{
  "name": "orca-pod",
  "version": "0.0.0",
  "private": true,
  "description": "Orca pod: full-mesh agent node for DeepSeek Harness, self-contained as one package.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/harness.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "bin": {
    "orca-node": "./src/cli.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "fastify": "^5.6.0"
  }
}

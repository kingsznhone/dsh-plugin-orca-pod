{
  "name": "orca-pod",
  "version": "0.0.0",
  "private": true,
  "description": "Orca pod: full-mesh agent node for DeepSeek Harness, self-contained as one package.",
  "type": "module",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "orca",
    "mesh",
    "agent"
  ],
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "skills",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-client.ts",
    "prepare": "npm run build",
    "check": "biome check . && tsc --noEmit && tsc --noEmit -p client && vitest run",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "test": "vitest run",
    "harness": "node --no-warnings --import tsx scripts/harness_run.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.8.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-app-boot": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-atomic-write": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-error": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-launch-environment": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-native-command": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-timeout": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.5",
    "bs58": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.12.8",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-config-editor": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}

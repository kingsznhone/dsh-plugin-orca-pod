{
  "name": "orca-pod",
  "version": "0.0.0",
  "private": true,
  "description": "Orca pod: full-mesh agent node for DeepSeek Harness, self-contained as one package.",
  "type": "module",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "orca",
    "mesh",
    "agent"
  ],
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/node/harness.d.ts",
      "default": "./lib/node/harness.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "skills",
    "README.md"
  ],
  "bin": {
    "orca-node": "./lib/cli/main.js",
    "orca-pod": "./lib/cli/orca-pod.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-client.ts",
    "prepare": "npm run build",
    "check": "biome check . && tsc --noEmit && tsc --noEmit -p client && vitest run",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "test": "vitest run",
    "harness": "node --no-warnings scripts/harness_run.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.7.0",
    "fastify": "^5.12.8",
    "typebox": "^1.4.7",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

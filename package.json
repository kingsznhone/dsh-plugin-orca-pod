{
  "name": "orca-pod",
  "version": "0.0.0",
  "private": true,
  "description": "Orca pod: full-mesh agent node for DeepSeek Harness, self-contained as one package.",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/harness.ts",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    ".agents/skills",
    "README.md"
  ],
  "bin": {
    "orca-node": "./src/cli.ts",
    "orca-pod": "./src/orca-pod.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness": "node --no-warnings src/harness-run.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
